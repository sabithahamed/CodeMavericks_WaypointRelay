# Copy to .env to override the defaults used by docker compose.
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay
# Secret used to sign session tokens. Use a long random value in production.
JWT_SECRET=change-me-in-production
# Host port for the web app (http://localhost:8080)
APP_PORT=8080

# Only for running the server outside Docker:
# DATABASE_URL=postgres://relay:relay@localhost:5432/relay
# DATABASE_SSL=false
